# Hosted demo on a Hugging Face Space (CPU). AI calls go to Google Gemini via a server-side secret.
FROM node:22-slim AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg nodejs ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
# Hugging Face runs Spaces as user 1000.
RUN useradd -m -u 1000 user
WORKDIR /app/backend
COPY --chown=user backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY --chown=user backend/ ./
RUN uv sync --frozen --no-dev
COPY --chown=user --from=web /web/dist /app/frontend/dist
RUN mkdir -p /app/backend/data && chown -R user:user /app
USER user
ENV HOME=/home/user \
    NIRIKSHAK_PROVIDER=cloud \
    NIRIKSHAK_WHISPER=small \
    NIRIKSHAK_WHISPER_DEVICE=cpu \
    NIRIKSHAK_MAX_DURATION=1500 \
    HF_HOME=/app/backend/data/hf
EXPOSE 7860
CMD ["uv", "run", "--no-dev", "nirikshak", "serve", "--host", "0.0.0.0", "--port", "7860"]
